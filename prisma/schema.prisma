generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  SUBMITTED
  PAID
  BOUGHT
  SHIPPED_BY_STORE
  SHIPPED
  DELIVERED
  CANCELLED
}

model ExchangeRate {
  id        String   @id @default(cuid())
  aedToIrr  Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id    String  @id @default(cuid())
  name  String
  phone String  @unique
  email String?
  role  Role    @default(USER)

  storeOrders StoreOrder[]
  webOrders   WebOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OtpToken {
  id        String   @id @default(cuid())
  phone     String   @unique
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id    String  @id @default(cuid())
  name  String
  slug  String  @unique
  image String?

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryTree")

  products Product[]

  @@index([parentId])
}

model Product {
  id    String  @id @default(cuid())
  title String
  slug  String  @unique
  sku   String? @unique
  brand String?

  description String?
  url         String?
  images      String[]

  specs     String[] @default([])
  isExpress Boolean  @default(false)
  isActive  Boolean  @default(true)
  totalSold Int      @default(0)

  categoryId      String
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants        ProductVariant[]
  storeOrderItems StoreOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([categoryId, isActive])
  @@index([isExpress])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  attributes VariantAttribute[]

  sku       String?  @unique
  images    String[]
  aedPrice  Float
  irrPrice  Float
  stock     Int      @default(0)
  isDefault Boolean  @default(false)

  storeOrders StoreOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([isDefault])
}

model VariantAttribute {
  id        String         @id @default(cuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  key   String
  value String

  @@index([variantId])
  @@index([key, value])
}

model StoreOrder {
  id     Int     @id @default(autoincrement())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull) // Preserves order if user is deleted

  shippingAddress String
  note            String?
  items           StoreOrderItem[]
  zarinpalref     String?          @unique
  zarinpalauth    String?          @unique

  status OrderStatus @default(SUBMITTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model StoreOrderItem {
  id      String     @id @default(cuid())
  orderId Int
  order   StoreOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product         @relation(fields: [productId], references: [id]) // Restrict: prevents deleting products inside orders
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  quantity Int @default(1)

  unitAedPrice Float
  unitIrrPrice Float

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}

model WebOrder {
  id String @id @default(cuid())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  store  String?

  requestedUrl   String
  requestedTitle String?

  actualUrl      String?
  actualAedCost  Float?
  trackingNumber String?

  quantity        Int     @default(1)
  unitAedPrice    Decimal
  unitIrrRate     Float
  totalIrrPrice   Float
  shippingAddress String

  status OrderStatus @default(SUBMITTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}
